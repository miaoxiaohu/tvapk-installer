# ---- 签名密钥：绝不能进仓库 ----------------------------------------------
# 泄露后任何人都能签出「看起来是你签的」APK，Android 也无法区分。
*.jks
*.keystore
keystore.properties

# ---- 本机配置 --------------------------------------------------------------
local.properties

# ---- 构建产物 --------------------------------------------------------------
build/
*.apk
*.aab
*.ap_
*.dex
*.class

# ---- 工具链（本机装的 SDK / Gradle / 缓存，几百 MB）-------------------------
/android-sdk/
/.gradle/
/gradle/gradle-*/
/.toolcache/

# ---- 本项目的杂项 ----------------------------------------------------------
/dl/
/out/
/upstream/
/.probe/
/.preview/
/probe/
*.log

# ---- 其它项目（同一个工作区里的别的仓库）----------------------------------
/hongguoTV/

# ---- 编辑器 / 系统 ----------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---- Web 测试台产物 --------------------------------------------------------
/tools/apkcheck/
/tools/*.png