<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive-button label: bright only while that button actually holds focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="#FFFFFFFF" />
    <item android:state_focused="true" android:color="#FFFFFFFF" />
    <item android:color="@color/danger_rest_text" />
</selector>